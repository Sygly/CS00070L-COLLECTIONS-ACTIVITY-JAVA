package com.mycompany.campuslostandfound;

/**
 *
 * @author SYVYL GLYNN M. GARAY
 */

import java.util.ArrayList;
import java.util.Scanner;

public class CampusLostAndFound {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        ArrayList<String> reports = new ArrayList<>();

        int choice = 0;

        do {
            System.out.println("\n=== CAMPUS LOST-AND-FOUND TRACKER ===");
            System.out.println("1. Add an item description");
            System.out.println("2. View all reports");
            System.out.println("3. Search reports");
            System.out.println("4. Remove a report");
            System.out.println("5. Show total reports");
            System.out.println("6. Exit");
            System.out.print("Enter your choice: ");

            if (!sc.hasNextInt()) {
                System.out.println("Invalid input! Enter a number.");
                sc.nextLine();
                continue;
            }

            choice = sc.nextInt();
            sc.nextLine();

            switch (choice) {
                case 1:
                    System.out.print("Enter item description: ");
                    String item = sc.nextLine();

                    if (item.trim().isEmpty()) {
                        System.out.println("Description cannot be empty.");
                    } else {
                        reports.add(item);
                        System.out.println("Item added successfully!");
                    }
                    break;

                case 2:
                    System.out.println("\n=== ALL REPORTS ===");

                    if (reports.isEmpty()) {
                        System.out.println("No reports available.");
                    } else {
                        for (int i = 0; i < reports.size(); i++) {
                            System.out.println((i + 1) + ". " + reports.get(i));
                        }
                    }
                    break;

                case 3:
                    System.out.print("Enter keyword to search: ");
                    String keyword = sc.nextLine().toLowerCase();
                    boolean found = false;

                    System.out.println("\n=== SEARCH RESULTS ===");

                    for (int i = 0; i < reports.size(); i++) {
                        if (reports.get(i).toLowerCase().contains(keyword)) {
                            System.out.println((i + 1) + ". " + reports.get(i));
                            found = true;
                        }
                    }

                    if (!found) {
                        System.out.println("No matching reports found.");
                    }
                    break;

                case 4:
                    if (reports.isEmpty()) {
                        System.out.println("No reports to remove.");
                        break;
                    }

                    System.out.print("Enter report number to remove: ");

                    if (!sc.hasNextInt()) {
                        System.out.println("Invalid input! Enter a number.");
                        sc.nextLine();
                        break;
                    }

                    int position = sc.nextInt();
                    sc.nextLine();

                    if (position >= 1 && position <= reports.size()) {
                        String removed = reports.remove(position - 1);
                        System.out.println("Removed report: " + removed);
                    } else {
                        System.out.println("Invalid report number!");
                    }
                    break;

                case 5:
                    System.out.println("Total reports: " + reports.size());
                    break;

                case 6:
                    System.out.println("Thank you for using the tracker!");
                    break;

                default:
                    System.out.println("Invalid choice! Please try again.");
            }

        } while (choice != 6);

        sc.close();
    }
}

